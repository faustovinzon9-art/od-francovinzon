{
  "crons": [
    {
      "path": "/api/gestion/pacientes?modo=healthcheck",
      "schedule": "0 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/t/:codigo",
      "destination": "/api/reservar?codigo=:codigo"
    }
  ],
  "functions": {
    "api/gestion/admin.js": { "maxDuration": 300 },
    "api/gestion/pacientes.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs"
    }
  }
}
